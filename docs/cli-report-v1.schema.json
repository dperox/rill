{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Japka migration, preflight and CLI error report v1",
  "type": "object",
  "required": ["schema_version", "command", "status", "diagnostics"],
  "properties": {
    "schema_version": {"const": 1},
    "command": {"enum": ["migrate nginx", "config test", "cli"]},
    "status": {"enum": ["translated", "review_required", "error", "valid", "invalid"]},
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "additionalProperties": false,
        "properties": {
          "code": {"type": "string"},
          "message": {"type": "string"},
          "path": {"type": "string"},
          "file": {"type": ["string", "null"]},
          "line": {"type": ["integer", "null"], "minimum": 1},
          "context": {"type": "string"},
          "directive": {"type": "string"},
          "status": {"enum": ["translated", "behavior_differs", "unsupported"]}
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "command": {"const": "migrate nginx"},
        "status": {"enum": ["translated", "review_required"]},
        "candidate": {
          "type": "object",
          "required": ["config", "environment"],
          "additionalProperties": false,
          "properties": {
            "config": {
              "type": "object",
              "required": ["sites", "routes"],
              "additionalProperties": false,
              "properties": {
                "sites": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["host", "root"],
                    "additionalProperties": false,
                    "properties": {
                      "host": {"type": "string"},
                      "root": {"type": "string"}
                    }
                  }
                },
                "routes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["prefix", "upstreams"],
                    "additionalProperties": false,
                    "properties": {
                      "host": {"type": "string"},
                      "prefix": {"type": "string"},
                      "upstreams": {
                        "type": "array",
                        "minItems": 1,
                        "items": {"type": "string"}
                      },
                      "failover": {"type": "boolean"}
                    }
                  }
                }
              }
            },
            "environment": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        }
      },
      "required": ["candidate"]
    },
    {
      "properties": {"command": {"const": "config test"}, "status": {"enum": ["valid", "invalid"]}},
      "not": {"required": ["candidate"]}
    },
    {
      "properties": {"command": {"enum": ["migrate nginx", "cli"]}, "status": {"const": "error"}},
      "not": {"required": ["candidate"]}
    }
  ],
  "unevaluatedProperties": false
}
