FROM rust:1-bookworm AS build
ENV CARGO_TARGET_DIR=/target
WORKDIR /baseline
ADD base.tgz /baseline/
RUN cargo build --release --locked && cp /target/release/rill /usr/local/bin/rill-base
WORKDIR /candidate
ADD candidate.tgz /candidate/
RUN cargo build --release --locked

FROM nginx:1.31.10
COPY --from=build /usr/local/bin/rill-base /usr/local/bin/rill-base
COPY --from=build /target/release/rill /usr/local/bin/rill
ENV LISTEN=0.0.0.0:8080
USER 10001:10001
